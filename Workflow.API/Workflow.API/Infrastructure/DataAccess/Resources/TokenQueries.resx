  <data name="ADD_OR_UPDATE_TOKEN" xml:space="preserve">
    <value>MERGE tbl_Token AS Target
USING (SELECT  
	@UserId iUserId, 
	@TokenType iTokenType,
	@TokenString vcTokenString,
	@CreationDateTime dtCreationDateTime,
	@ExpiryDateTime dtExpiryDateTime)
	AS Source
ON Source.iUserId = Target.iUserId AND Source.iTokenType = Target.iTokenType
WHEN NOT MATCHED BY Target THEN
	INSERT (iUserId, iTokenType, vcTokenString, dtCreationDateTime, dtExpiryDateTime)
	VALUES (Source.iUserId, Source.iTokenType, Source.vcTokenString, Source.dtCreationDateTime, Source.dtExpiryDateTime)
WHEN MATCHED THEN
	UPDATE SET
		Target.vcTokenString = Source.vcTokenString,
		Target.dtCreationDateTime = Source.dtCreationDateTime,
		Target.dtExpiryDateTime = Source.dtExpiryDateTime
OUTPUT
	INSERTED.iTokenId Id,
	INSERTED.iUserId UserId,
	INSERTED.iTokenType TokenType,
	INSERTED.vcTokenString TokenString,
	INSERTED.dtCreationDateTime CreationDateTime,
	INSERTED.dtExpiryDateTime ExpiryDateTime;</value>
  </data>
  <data name="DELETE_TOKEN" xml:space="preserve">
    <value>DELETE FROM tbl_Token
OUTPUT
	DELETED.iTokenId Id,
	DELETED.iUserId UserId,
	DELETED.iTokenType TokenType,
	DELETED.vcTokenString TokenString,
	DELETED.dtCreationDateTime CreationDateTime,
	DELETED.dtExpiryDateTime ExpiryDateTime
WHERE iTokenId = @TokenId</value>
  </data>
  <data name="GET_BY_TOKEN_STR_TOKEN_TYPE" xml:space="preserve">
    <value>SELECT
	iTokenId Id,
	iUserId UserId,
	iTokenType TokenType,
	vcTokenString TokenString,
	dtCreationDateTime CreationDateTime,
	dtExpiryDateTime ExpiryDateTime
FROM tbl_Token
WHERE vcTokenString = @TokenStr AND iTokenType = @TokenType</value>
  </data>
  <data name="GET_BY_USER_ID_TOKEN_TYPE" xml:space="preserve">
    <value>SELECT
	iTokenId Id,
	iUserId UserId,
	iTokenType TokenType,
	vcTokenString TokenString,
	dtCreationDateTime CreationDateTime,
	dtExpiryDateTime ExpiryDateTime
FROM tbl_Token
WHERE iUserId = @UserId AND iTokenType = @TokenType</value>
